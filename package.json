{
  "name": "@meesayen/pure-tooltip",
  "version": "1.0.1",
  "description": "Framework-agnostic tooltip library with Vue, React, Svelte and Custom Elements outputs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meesayen/pure-tooltip.git"
  },
  "homepage": "https://github.com/Meesayen/pure-tooltip#readme",
  "bugs": {
    "url": "https://github.com/Meesayen/pure-tooltip/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs"
    },
    "./ce": {
      "types": "./dist/ce.d.ts",
      "import": "./dist/ce.js",
      "require": "./dist/ce.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:demo": "vite --config vite.demo.config.ts",
    "dev:demo:react": "vite --config vite.demo.config.ts --open /react.html",
    "dev:demo:svelte": "vite --config vite.demo.config.ts --open /svelte.html",
    "dev:demo:ce": "vite --config vite.demo.config.ts --open /ce.html",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build:all": "npm run build && npm run build:demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svelte": "^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/language-core": "^3.3.14",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}
